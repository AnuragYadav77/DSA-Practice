class Solution {
public:
    int characterReplacement(string s, int k) {

        int max_count = 0;
        for (char i = 'A'; i <= 'Z'; i++) {
            int left = 0;
            int right = 0;
            int replaced = 0;

            while (right < s.length()) {
                if (s[right] != i)
                    replaced++;
                while (replaced > k) {
                    if (s[left] != i)
                        replaced--;
                    left++;
                }
                max_count = max(max_count, right - left + 1);
                right++;
            }
        }
        return max_count;
    }
};
