class Solution {
public:
    void reverseString(vector<char>& s) {
        int n;
        cin>>n;
        char s[n];
        for(int i=0;i<n;i++){
            cin>>s[i];
        }
        for(int j=0,k=n-1;j<n,k>=0;j++,k--){
            char temp=s[j];
            s[j]=s[k];
            s[k]=temp;
            cout<<s[j]<<endl;
        }
        

    }
};
