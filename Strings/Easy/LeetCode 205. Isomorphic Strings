// brute force approach
// we are going to compare the ith and (i+1)th letters of string s,if they are equal(same)or different then jth and (j+1)th letters of string t should also be same or different respectively.
class Solution {
public:
    bool isIsomorphic(string s, string t) {
        if(s.length()!=t.length()) return false; //if both strings are of different length, then they can't be mapped
        for(int i=0;i<s.length();i++){
            for(int j=i+1;j<s.length();j++){
                if(s[i]==s[j] && t[i]!=t[j]) return false;
                if(s[i]!=s[j] && t[i]==t[j]) return false;
            }
        }
        return true;
    }
};
