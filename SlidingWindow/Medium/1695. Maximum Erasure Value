class Solution {
public:
    int maximumUniqueSubarray(vector<int>& nums) {
    int left=0;
    int right=0;
    int sum=0,max_score=0 ;
    set<int> s; //to maintain the elements in current window.
    while(right<nums.size()){
        while(s.count(nums[right])){ //checks whether the new added element is already present
              sum-=nums[left];
              s.erase(nums[left]);
              left++;
        }
        sum+=nums[right];
        s.insert(nums[right]);
        max_score=max(max_score,sum);
        right++;
    } 
    return max_score;      
    }
};
