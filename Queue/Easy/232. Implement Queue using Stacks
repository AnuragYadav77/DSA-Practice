class MyQueue {
        stack<int> s1,s2;

public:
    MyQueue() {
    }
    
    void push(int x) {
        while(!s1.empty()){
            s2.push(s1.top()); //pushing all elements from s1 to s2
            s1.pop();
        }
        s1.push(x); //push new element into s1.
        while(!s2.empty()){
            s1.push(s2.top()); //pushing back all items from s2 to s1
            s2.pop();
        }
        
    }
    
    int pop() {
        if(s1.empty()) return -1;
        int x=s1.top();
        s1.pop();
        return x;
        
    }
    
    int peek() {
        if(s1.empty()) return -1;
        else return s1.top();
        
    }
    
    bool empty() {
        if(s1.empty()) return true;
        else return false;
        
    }
};
