#include<vector>
#include <algorithm>
using namespace std;
class Solution {
public:
    int timeRequiredToBuy(vector<int>& tickets, int k) {
        int time=0;
        for(int i=0;i<tickets.size();i++){ //here i is current index and k is target index
            if(i<=k){
                time+=min(tickets[i],tickets[k]);
            }
            else{
                time+=min(tickets[i],tickets[k]-1);
            }
        }
        return time;
    }
};
