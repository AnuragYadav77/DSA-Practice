class Solution {
public:
    int mySqrt(int x) {
       int start=1;
       int end=x;
       if(x==0 || x==1) return x;
        while(start<=end){
        long mid=start+(end-start)/2;
        if(long(mid*mid)==long(x)) return mid;
        else if (mid*mid>x) end=mid-1;
        else start=mid+1;
       } 
       return end;
    }
};
