class Solution {
public:
    int findMin(vector<int>& nums) {
            int n=nums.size();
            int low=0;
            int high=n-1;
            while(low<high){
                 int mid=low+(high-low)/2;
                 if(nums[mid]>nums[high]) low=mid+1;
                 else high=mid; // we aren't doing mid-1 coz mid itself could be minimum so we are keeping it in search range.
            }
            return nums[low];
     }
}; 
