class Solution {
public:
    char nextGreatestLetter(vector<char>& letters, char target) {
          int low=0;
          int high=letters.size()-1;
          int position=-1;
          while(low<=high){
            int mid=low+(high-low)/2;
            if(letters[mid]>target){ //excatly what we want
                position=mid;
                high=mid-1; //traversing to the left to check if there is any element lesser than element at mid
            }
            else{
                low=mid+1;
            }
          }
          if(position==-1) return letters[0];
          else return letters[position];
    }
};
