class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        double sum=0;
        for(int i=0;i<k;i++){ //getting sum of the first window.
            sum+=nums[i];
        }
        double maxsum=sum;
        int n=nums.size();
        int left=0;
        int right=k;
        while(right<n){
            sum-=nums[left]; //removing previous element
            left++;

            sum+=nums[right]; //adding the new element
            right++;
            
            maxsum=max(maxsum,sum);
           
        }
        return maxsum/k ;
    }
};
