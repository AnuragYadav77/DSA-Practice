class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
            int i=0;
            for(int j=1;j<nums.size();j++){
                if(nums[i]!=nums[j]){
                    i++;
                    nums[i]=nums[j];  //storing the unique element in place of the repeated/duplicate element.  
                }
            }
         return i+1;  //no of unique elements present in array
    }   
};
