class Solution {
public:
    int singleNonDuplicate(vector<int>& nums) {
        int i = 0;
        while (i < nums.size()-1) {
            if (nums[i] == nums[i+1]) {
                i += 2;  // skip the pair
            } else {
                return nums[i]; // found the single element
            }
        }
        return nums[i]; // last element is unique
    }
};
