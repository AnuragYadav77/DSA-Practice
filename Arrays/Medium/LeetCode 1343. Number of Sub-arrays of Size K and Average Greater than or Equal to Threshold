class Solution {
public:
    int numOfSubarrays(vector<int>& arr, int k, int threshold) {
        int n = arr.size();
        int count = 0;
        int sum=0;
        // int left = 0, right = k;
        // while(right<=n){
        //     int sum=0; //setting sum as 0 for every window becasue here i haven't used sliding window technique instead i'm looping from left to right for each sub array. TC-O(n*k).
        //     for(int i=left;i<right;i++){
        //         sum+=arr[i];
        //     }
        //     if (sum / k >= threshold) count++;
        //     left++;
        //     right++;
        // }
        // return count;
        ///////////////////////////////////////

        //using sliding window: TC = O(n).
        for(int i=0;i<k;i++) sum+=arr[i]; //sum of initial window
        if(sum/k>=threshold) count++;
        for(int i=k;i<n;i++){
            sum+=arr[i]-arr[i-k]; //adding new element to sum and subtracting old element from sum        
            if(sum/k>=threshold) count++;
        }
        return count;
    }
};
